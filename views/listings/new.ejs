<% layout("/layouts/boilerplate")%>
    <div class="row">
        <div class="col-8 offset-2">
             <br><br> 
    <h3>Create New Listing</h3>
    <br>
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" class="form-control"  required placeholder="Enter Title" type="text">
            <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Enter your Title
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required placeholder="Enter Description" type="text"></textarea>
            <div class="invalid-feedback">
                Enter short Description
            </div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input name="listing[image]" class="form-control" type="file" required>
            <div class="invalid-feedback">
                Enter valid image/file
            </div> 
        </div>
        <div class="row">
            <div class="mb-3 col-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" class="form-control" required placeholder="Enter Price">
                <div class="invalid-feedback">
                    Price should be valid
                </div>
            </div>
            <div class="mb-3 col-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" class="form-control" required placeholder="India" type="text">
                <div class="invalid-feedback">
                    Country name should be valid
                </div>
            </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" class="form-control" required placeholder="Karnataka,bengaluru" type="text">
            <div class="invalid-feedback">
                Location name should be valid
            </div>
        </div>
        
        <br><br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
</div>
</div>

