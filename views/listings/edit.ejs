<% layout("/layouts/boilerplate")%>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br> 
    <h3>Edit <%=listing.title%> Details</h3>
    <br>
    <form method="post" action="/listings/<%=listing._id%>?_method=put" novalidate class="needs-validation" enctype="multipart/form-data">
         <div class="mt-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" class="form-control" required value="<%= listing.title%>" type="text">
            <div class="invalid-feedback">
                Enter your Title
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required type="text"><%= listing.description%></textarea>
            <div class="invalid-feedback">
                Enter short Description
            </div> 
        </div>
        <div class="mb-3">
            Original Listing Image <br>
            <img src=" <%= originalUrl%>" class=" show-img" alt="listing_image">
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label>
            <input name="listing[image]" class="form-control" required  type="file">
            <div class="invalid-feedback">
                Enter valid URL
            </div> 
        </div>
        <div class="row">
            <div class="mb-3 col-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" class="form-control" required value="<%= listing.price%>" type="number">
                <div class="invalid-feedback">
                    Price should be valid
                </div>
            </div>
            <div class="mb-3 col-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" class="form-control" required value="<%= listing.country%>" type="text">
            </div>
            <div class="invalid-feedback">
                    Country name should be valid
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" class="form-control" required value="<%= listing.location%>" type="text">
            <div class="invalid-feedback">
                Location name should be valid
            </div>
        </div>
        
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
</div>
</div>
<script src="/js/script.js"></script>